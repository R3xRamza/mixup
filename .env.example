# Signaling server
PORT=8787

# Comma-separated browser origins. Leave unset on your own machine.
# Set this when the server is reachable by anyone else.
# MIXUP_ALLOWED_ORIGINS=https://mixup.example

# Set to 1 only when a reverse proxy overwrites X-Forwarded-For.
# MIXUP_TRUST_PROXY=

# Client. Defaults to ws://localhost:8787.
# VITE_SIGNAL_URL=wss://signal.example
